# 배포본(GitHub Pages)용 설정 예시.
# 이 파일을 .env.production 으로 복사해 값을 채우거나,
# 저장소 Settings → Secrets and variables → Actions → Variables 에 같은 이름으로 등록한다.

# 배포된 프론트가 호출할 백엔드 절대주소.
# 정적 호스팅에는 개발 서버 프록시가 없으므로 반드시 절대주소여야 한다.
# GitHub Pages 는 HTTPS 라서 http:// 주소를 넣으면 브라우저가 혼합 콘텐츠로 차단한다.
# 백엔드에는 https://likelionhgu.github.io 를 CORS 허용 출처로 등록해야 한다.
VITE_API_BASE_URL=https://api.example.com/api

# 저장소 이름이 아닌 경로에 올릴 때만 지정한다. (기본값 /CUSTODIA_Front/)
# 커스텀 도메인을 쓰면 VITE_BASE_PATH=/
# VITE_BASE_PATH=/
